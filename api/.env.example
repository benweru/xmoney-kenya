# Sandbox only. This build refuses to start if SANDBOX_MODE is not true.
SANDBOX_MODE=true

# Dev database. Tests use the xmoney_test database and will not touch this one.
DATABASE_URL=postgresql+psycopg://xmoney:xmoney@localhost:5432/xmoney
# On AWS the URL is built from DB_HOST, DB_PORT, DB_NAME, DB_USERNAME, DB_PASSWORD, and
# DB_SSLMODE (default require) instead, and DATABASE_URL is ignored.

# Top-up rails offered, default first: "mock" (the Daraja mock this API serves) and
# "sandbox" (Safaricom's Daraja sandbox). Each top-up remembers its rail.
PAYMENT_RAILS=["mock"]
DARAJA_MOCK_BASE_URL=http://127.0.0.1:8000/sandbox/daraja
# Where the mock posts callbacks. Unset means PUBLIC_BASE_URL.
# DARAJA_MOCK_CALLBACK_BASE_URL=

# The sandbox rail's keys. These placeholders are refused when "sandbox" is in PAYMENT_RAILS;
# see docs/runbooks/daraja-sandbox-top-up.md. Never commit real keys.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=sandbox
DARAJA_CONSUMER_SECRET=sandbox
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=sandbox-passkey
# Sandbox STK prompts reach real handsets. A public (https) demo must list the phones allowed.
DARAJA_SANDBOX_ALLOWED_PHONES=[]

# STK callbacks go to $PUBLIC_BASE_URL/v1/payments/stk/callback/$STK_CALLBACK_TOKEN.
# Leave the token unset locally (random per process); set it when several API instances share a URL.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# STK_CALLBACK_TOKEN=
STK_QUERY_AFTER_SECONDS=60
STK_QUERY_INTERVAL_SECONDS=15
STK_EXPIRE_AFTER_SECONDS=300
B2C_EXPIRE_AFTER_SECONDS=300
# B2C (sandbox rail). The mock accepts the placeholders. Do not commit real credentials.
DARAJA_INITIATOR_NAME=testapi
DARAJA_SECURITY_CREDENTIAL=sandbox
# DARAJA_B2C_SHORTCODE=

# Sign-in. Turn SESSION_COOKIE_SECURE on whenever the API is served over https.
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
SESSION_TTL_MINUTES=720
SESSION_COOKIE_SECURE=false

# Local development only: POST /v1/sandbox/journal-entries credits any wallet. Off (404) unless true.
# The API refuses to start with this on when PUBLIC_BASE_URL is https.
SANDBOX_JOURNAL_ENABLED=false
# Staff apply/refund/reverse on /v1/console. On by default for local http; 404 when false.
# The API refuses to start with this on when PUBLIC_BASE_URL is https.
CONSOLE_MONEY_MOVING_ENABLED=true
# Open-demo protections (docs/adr/006-open-demo-protections.md).
RATE_LIMITS_ENABLED=true
# Proxies that append to X-Forwarded-For. 0 locally; 2 behind CloudFront + ALB.
TRUSTED_PROXY_HOPS=0
# Largest single top-up, in cents. The public demo lowers it.
TOPUP_MAX_CENTS=25000000
# Full reversals at or above this (cents) stay proposed until a different actor approves.
REVERSAL_MAKER_CHECKER_CENTS=10000
# Demo staff console login (docs/adr/018-staff-console.md). Empty DEMO_STAFF_PIN skips the seed.
# DEMO_STAFF_HANDLE=ops
# DEMO_STAFF_PIN=2580
DARAJA_MOCK_CONTROL_ENABLED=true
# Origins allowed to call the API with cookies, as a JSON list. Only `make run-web` (next dev) needs it.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
