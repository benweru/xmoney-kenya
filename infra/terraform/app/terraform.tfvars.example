# Copy to terraform.tfvars (gitignored). `make aws-up` passes api_image_tag itself.
# api_image_tag = "<git sha of an image already in ECR>"

# Offer Safaricom's Daraja sandbox next to the mock. Fill the foundation's
# xmoney-demo/daraja-sandbox secret first (docs/runbooks/aws-first-deploy.md).
enable_sandbox_rail    = false
sandbox_allowed_phones = [] # ["+2547XXXXXXXX"], your own test handset

# topup_max_kes           = 1000
# resolve_topups_schedule = "rate(10 minutes)"
# demo_reset_schedule     = "cron(0 3 * * ? *)" # Africa/Nairobi
